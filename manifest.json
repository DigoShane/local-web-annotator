{
  "manifest_version": 3,
  "name": "Local Web Annotator 0.4.7",
  "description": "Highlight web pages, add comments and movable graphic notes, and save/restore annotations from local JSON files.",
  "version": "0.4.7",
  "permissions": [
    "storage",
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Local Web Annotator",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}